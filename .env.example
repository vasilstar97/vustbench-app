# Copy to .env to override Compose settings. Input files belong under data/.
# Use a graph archive built with IduEdu 3.4:
# VUSTBENCH_GRAPH_PATH=/app/data/spb.urbangraph

# Or use a local OSM extract instead of Overpass:
# IDUEDU_OSM_SOURCE=pbf
# IDUEDU_PBF_PATH=/app/data/spb.osm.pbf

OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT=120
OVERPASS_MAX_RETRIES=1
VUSTBENCH_GRAPH_TIMEOUT_SECONDS=600
VUSTBENCH_RUN_TIMEOUT_SECONDS=1800
